<%- include("partials/header", { title }) %>

<section class="page-heading">
    <span class="tag">HEALTH QUESTIONNAIRE · STEP 1 OF 3</span>
    <h1>Tell us about your health and wellbeing</h1>
    <p>Answer one question at a time. Follow-up questions are selected locally based on your choices.</p>
</section>

<form action="/health" method="POST" id="healthQuestionnaireForm">
    <section class="card health-contact-card" aria-labelledby="contactHeading">
        <h2 id="contactHeading">Session details</h2>
        <p>Your name and email identify this assessment session. Health answers are stored as structured choices.</p>
        <div class="health-contact-fields">
            <label for="name">Full name</label>
            <input id="name" type="text" name="name" maxlength="80" autocomplete="name" required>

            <label for="email">Email address</label>
            <input id="email" type="email" name="email" maxlength="120" autocomplete="email" required>
        </div>
    </section>

    <section class="card health-question-card" aria-labelledby="healthQuestionTitle">
        <div class="health-question-progress">
            <span id="healthQuestionCount">Question 1</span>
            <span id="healthProgressPercent">0% complete</span>
        </div>
        <progress id="healthQuestionProgress" value="0" max="100" aria-label="Questionnaire completion progress">0%</progress>
        <div id="healthQuestionContent" class="health-question-content" aria-live="polite"></div>
        <p id="healthQuestionError" class="health-question-error" role="alert" hidden></p>

        <div class="health-question-actions">
            <button type="button" class="health-secondary-button" id="healthPrevious" hidden>Previous</button>
            <button type="button" class="btn" id="healthNext">Continue</button>
            <button type="submit" class="btn" id="healthSubmit" hidden>
                Save answers and continue to eye assessments
            </button>
        </div>
    </section>

    <input type="hidden" name="questionnaireResponses" id="questionnaireResponses">

    <p class="disclaimer">
        These self-reported answers are not a diagnosis. You can choose “Not sure” or “Prefer not to answer” where offered.
        No health answers are sent to an AI provider unless you separately consent on the report page.
    </p>
</form>

<script id="healthQuestionnaireData" type="application/json"><%- questionnaireJson %></script>
<script src="/js/health-questionnaire.js" defer></script>

<%- include("partials/footer") %>
