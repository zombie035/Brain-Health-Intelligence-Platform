
<%- include("partials/header") %>

<div class="container">

    <div class="page-heading">
        <h1>Assessment History</h1>
        <p>Track your previous cognitive assessment sessions.</p>
    </div>

    <div class="history-summary">

        <div class="summary-card">
            <h3>Total Sessions</h3>
            <h2><%= history.length %></h2>
        </div>

        <div class="summary-card">
            <h3>Latest Memory</h3>
            <h2>
                <%= history.length ? history[0].memoryPct + "%" : "N/A" %>
            </h2>
        </div>

        <div class="summary-card">
            <h3>Latest Reaction</h3>
            <h2>
                <%= history.length ? history[0].reactionMs + " ms" : "N/A" %>
            </h2>
        </div>

    </div>

    <div class="history-table-container">

        <h2>Previous Assessments</h2>

        <% if (history.length > 0) { %>

            <table class="history-table">

                <thead>
                    <tr>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Memory</th>
                        <th>Attention</th>
                        <th>Reaction Time</th>
                        <th>Report</th>
                    </tr>
                </thead>

                <tbody>

                    <% history.forEach(item => { %>

                        <tr>

                            <td>
                                <%= item.session %>
                            </td>

                            <td>
                                <%= item.createdAt
                                    ? new Date(item.createdAt).toLocaleString("en-IN")
                                    : "N/A" %>
                            </td>

                            <td>
                                <%= item.memoryPct %>%
                            </td>

                            <td>
                                <%= item.attentionPct %>%
                            </td>

                            <td>
                                <%= item.reactionMs %> ms
                            </td>

                            <td>
                                <a href="/dashboard/<%= item._id %>">
                                    View Report
                                </a>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } else { %>

            <p>No previous assessments found.</p>

        <% } %>

    </div>

    <a
        href="/dashboard/<%= currentAssessment._id %>"
        class="back-button"
    >
        Back to Dashboard
    </a>

</div>

<%- include("partials/footer") %>
