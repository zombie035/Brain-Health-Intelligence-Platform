<%- include("partials/header", { title }) %>

<section class="page-heading">
    <span class="tag">DASHBOARD</span>
    <h1>Hello, <%= assessment.name %></h1>
    <p>Your eye assessment session and health profile are saved.</p>
    <a class="btn" href="/eye-assessment/<%= assessment._id %>/report">Open consolidated report</a>
    <a class="eye-back-link" href="/history/<%= assessment._id %>">Assessment history</a>
</section>

<div class="dashboard-grid">
    <article class="stat-card">
        <p>Completed eye assessments</p>
        <h2><%= completedCount %> / 4</h2>
        <span>All four assessments are required for a report.</span>
    </article>
    <article class="stat-card">
        <p>Sleep duration</p>
        <h2><%= healthProfile.sleepDuration || (healthProfile.sleepHours != null ? `${healthProfile.sleepHours} hrs` : "Not recorded") %></h2>
        <span>Self-reported range</span>
    </article>
    <article class="stat-card">
        <p>Physical activity</p>
        <h2><%= healthProfile.activityLevel || (healthProfile.exerciseMinutes != null ? `${healthProfile.exerciseMinutes} min` : "Not recorded") %></h2>
        <span>Self-reported level</span>
    </article>
</div>

<section class="card">
    <h2>Next scheduled BrainGuard assessment</h2>
    <% if (nextCalendarEvent) { %>
        <p><strong><%= nextCalendarEvent.title %></strong></p>
        <p><%= new Date(nextCalendarEvent.startAt).toLocaleString(undefined, {
            dateStyle: "medium",
            timeStyle: "short",
            timeZone: nextCalendarEvent.timeZone,
        }) %></p>
        <a class="btn" href="/calendar/<%= assessment._id %>">Manage calendar</a>
        <a class="eye-back-link" href="/calendar/<%= assessment._id %>?edit=<%= nextCalendarEvent._id %>#calendarEditor">Reschedule</a>
    <% } else { %>
        <p>No future assessment is scheduled.</p>
        <a class="btn" href="/calendar/<%= assessment._id %>?new=brain_guard_assessment">Schedule an assessment</a>
    <% } %>
</section>

<section class="card">
    <h2>Health profile</h2>
    <div class="profile-grid">
        <p><strong>Age range:</strong> <%= healthProfile.ageRange || healthProfile.age || "Not recorded" %></p>
        <p><strong>Preferred language:</strong> <%= healthProfile.language %></p>
        <p><strong>Education:</strong> <%= healthProfile.educationLevel %></p>
        <p><strong>Stress frequency:</strong> <%= healthProfile.stressFrequency || (healthProfile.stressLevel != null ? `${healthProfile.stressLevel} / 5` : "Not recorded") %></p>
        <p><strong>Family history:</strong> <%= familyHistoryLabel %></p>
    </div>
</section>

<p class="disclaimer">
    Eye-tracking measurements are experimental observations. They do not measure brain activity
    and cannot diagnose neurological conditions.
</p>

<%- include("partials/footer") %>
