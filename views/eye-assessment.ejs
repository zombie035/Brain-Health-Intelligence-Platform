<%- include("partials/header", { title, pageStylesheet }) %>

<section class="page-heading">
    <span class="tag">EXPERIMENTAL EYE MOVEMENT TESTS</span>
    <h1>Eye Assessment</h1>
    <p>
        Choose a test to record experimental gaze measurements for
        <strong><%= assessment.name %></strong>.
    </p>
    <a class="eye-back-link" href="/dashboard/<%= assessment._id %>">
        Back to dashboard
    </a>
</section>

<section class="eye-test-grid" aria-label="Available eye assessments">
    <article class="eye-test-card">
        <span class="eye-test-number">01</span>
        <h2>Attention Tracking Test</h2>
        <p>
            Complete browser-based calibration, then follow on-screen targets
            while GazeMap records gaze coordinates and timing.
        </p>
        <ul>
            <li>About 20 seconds</li>
            <li>Requires browser camera permission</li>
            <li>Calibration and stimulus stay on this webpage</li>
        </ul>
        <a
            class="btn"
            href="/eye-assessment/<%= assessment._id %>/attention"
        >
            View instructions
        </a>
    </article>

    <article class="eye-test-card">
        <span class="eye-test-number">02</span>
        <h2>Saccadic Eye Movement</h2>
        <p>
            Shift your gaze from the center fixation mark to left and right
            targets while GazeMap records calibrated samples.
        </p>
        <ul>
            <li>12 balanced left/right trials</li>
            <li>Requires a webcam and saved GazeMap calibration</li>
            <li>Stimulus appears in a fullscreen window</li>
        </ul>
        <a
            class="btn"
            href="/eye-assessment/<%= assessment._id %>/saccadic"
        >
            View instructions
        </a>
    </article>

    <article class="eye-test-card">
        <span class="eye-test-number">03</span>
        <h2>Smooth Pursuit</h2>
        <p>
            Follow a slowly moving target with your eyes to evaluate continuous
            gaze tracking and pursuit gain.
        </p>
        <ul>
            <li>30 seconds</li>
            <li>Requires a webcam and saved GazeMap calibration</li>
            <li>Stimulus appears in a fullscreen window</li>
        </ul>
        <a
            class="btn"
            href="/eye-assessment/<%= assessment._id %>/smooth-pursuit"
        >
            View instructions
        </a>
    </article>

    <article class="eye-test-card">
        <span class="eye-test-number">04</span>
        <h2>Blink &amp; Fatigue Monitoring</h2>
        <p>
            Measures blink frequency, blink duration and eye closure over a short
            recording to explore experimental fatigue-related observations.
        </p>
        <ul>
            <li>About 30 seconds</li>
            <li>Requires a webcam</li>
            <li>No calibration required</li>
        </ul>
        <a
            class="btn"
            href="/eye-assessment/<%= assessment._id %>/blink-monitoring"
        >
            View instructions
        </a>
    </article>

    <article class="eye-test-card">
        <span class="eye-test-number">05</span>
        <h2>Memory-Based Eye Tracking</h2>
        <p>
            Observe a series of words, then identify which ones you saw previously while your gaze is tracked.
        </p>
        <ul>
            <li>About 60 seconds</li>
            <li>Requires a webcam and saved GazeMap calibration</li>
            <li>Keyboard inputs required (Y/N)</li>
        </ul>
        <a class="btn" href="/eye-assessment/<%= assessment._id %>/memory-tracking">
            View instructions
        </a>
    </article>
</section>

<section class="card eye-previous-results">
    <h2>Recent Eye Assessments</h2>
    <% if (results.length) { %>
        <div class="eye-results-list">
            <% results.forEach(result => { %>
                <article class="eye-result-row">
                    <div>
                        <strong><%= result.status %></strong>
                        <span>
                            <%= result.assessmentType %> | <%= result.sessionId %>
                        </span>
                    </div>
                    <time datetime="<%= result.createdAt.toISOString() %>">
                        <%= new Date(result.createdAt).toLocaleString("en-IN") %>
                    </time>
                    <a href="/eye-assessment/<%= assessment._id %>/results/<%= encodeURIComponent(result.sessionId) %>">
                        View
                    </a>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <p>No eye assessment results have been saved yet.</p>
    <% } %>
</section>

<p class="disclaimer">
    These measurements are experimental observations, not a diagnosis or
    clinically validated screening result.
</p>

<%- include("partials/footer") %>