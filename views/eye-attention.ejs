<%- include("partials/header", { title, pageStylesheet }) %>

<section class="page-heading">
    <span class="tag">ASSESSMENT 01</span>
    <h1>Attention Tracking Test</h1>
    <p>
        Calibrate and follow the on-screen targets. Your browser streams camera
        frames to GazeMap for real gaze estimates; no desktop camera window is used.
    </p>
</section>

<section class="card eye-instructions">
    <h2>Before you begin</h2>
    <ol>
        <li>Allow camera access and sit comfortably with your face visible.</li>
        <li>Keep your head still and follow each calibration dot with your eyes.</li>
        <li>After calibration, follow the moving attention target. The test starts automatically.</li>
    </ol>
    <p>
        Camera video and gaze visualization stay on this page. Experimental
        gaze coordinates are saved to this assessment when the test finishes.
    </p>
</section>

<section
    id="attentionTest"
    class="card eye-test-runner"
    data-assessment-id="<%= assessment._id %>"
    data-gaze-ws-url="<%= typeof gazeWsUrl === 'string' && gazeWsUrl ? gazeWsUrl : 'ws://127.0.0.1:8001/ws/gaze' %>"
>
    <div class="eye-runner-heading">
        <div>
            <h2>Browser-based GazeMap</h2>
            <p>Assessment for <strong><%= assessment.name %></strong></p>
        </div>
        <a href="/eye-assessment/<%= assessment._id %>">Back to assessments</a>
    </div>

    <div class="eye-gaze-stage" id="gazeStage">
        <canvas
            id="gazeStageCanvas"
            aria-label="Calibration targets and live gaze position"
        ></canvas>
        <video id="gazeVideo" class="eye-camera-preview" autoplay playsinline muted aria-label="Live webcam preview"></video>
        <%- include("partials/eye-calibration-progress") %>
        <span class="eye-gaze-live-indicator" aria-hidden="true"></span>
        <p id="gazeStageMessage" class="eye-gaze-stage-message">
            Select Start Test to open your camera and begin web calibration.
        </p>
    </div>
    <div class="eye-runner-actions">
        <button class="btn" type="button" id="startAttentionTest">
            Start Test
        </button>
        <button
            class="eye-cancel-button"
            type="button"
            id="cancelAttentionTest"
            hidden
        >
            Cancel Test
        </button>
    </div>

    <p
        id="attentionStatus"
        class="eye-status"
        role="status"
        aria-live="polite"
    >
        Ready. The webcam starts only after you click Start Test.
    </p>

    <div
        class="eye-progress-track"
        role="progressbar"
        aria-label="Attention test progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
    >
        <div id="attentionProgress" class="eye-progress-fill"></div>
    </div>
    <p id="attentionProgressText" class="eye-progress-text">0%</p>
</section>

<p class="disclaimer">
    This experimental eye-movement task does not measure brain activity and
    cannot diagnose neurological conditions.
</p>

<script src="/js/eye-tests/calibration-ui.js?v=1" defer></script>
<script src="/js/eye-tests/attention.js?v=calibration-1" defer></script>
<%- include("partials/footer") %>
