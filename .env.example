PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/brainguard

# Local GazeMap service. In production, set this to the deployed HTTPS service URL.
GAZE_SERVICE_URL=http://127.0.0.1:8001

# Optional explicit browser WebSocket URL. Otherwise it is derived from
# GAZE_SERVICE_URL: http -> ws and https -> wss, using /ws/gaze.
# GAZE_WS_URL=ws://127.0.0.1:8001/ws/gaze

# Origins are the exact browser-facing BrainGuard site origins, comma-separated.
BRAINGUARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
